PORT=

# ================= AWS =================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket

# ================= AWS SES =================
# Optional; defaults to AWS_REGION
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY=your_ses_access_key
AWS_SES_SECRET_KEY=your_ses_secret_key
# Must be an SES-verified email address or an address on a verified domain
AWS_SES_FROM_EMAIL=noreply@your-verified-domain.com
AWS_SES_FROM_NAME=KRSA
